# Database
DATABASE_URL=postgresql://shortlister:shortlister@localhost:5432/resume_shortlister
POSTGRES_USER=shortlister
POSTGRES_PASSWORD=shortlister
POSTGRES_DB=resume_shortlister

# Backend
BACKEND_URL=http://localhost:8000
API_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production-use-openssl-rand-hex-32

# LLM Providers (fallback chain: Gemini -> Groq -> Ollama)
GROQ_API_KEY=
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434
LLM_PROVIDER_ORDER=gemini,groq,ollama
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile

# AI / ML
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
VECTOR_STORE_PATH=./vector_store
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Security
FILE_ENCRYPTION_KEY=
SENTRY_DSN=
RATE_LIMIT_PER_MINUTE=120
ENABLE_STRUCTURED_LOGGING=true

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
